{
  "name": "@podium/server",
  "version": "0.1.0",
  "private": true,
  "description": "Podium as a single Node process — the API and the web app on one port, for hosting that runs one app and no Redis.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only -P tsconfig.json src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint runs in @podium/api and @podium/web)\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@podium/api": "workspace:*",
    "@podium/web": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "next": "14.2.15",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
