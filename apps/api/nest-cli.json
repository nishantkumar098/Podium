{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "letters/assets/*.png",
        "watchAssets": true
      },
      {
        "include": "invoices/assets/*",
        "watchAssets": true
      }
    ]
  }
}
