model Freelancer {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String
  /// Nullable for the same reason as Client.cityId — see that comment.
  cityId         String?   @map("city_id") @db.Uuid
  phone          String?
  phoneRaw       String?   @map("phone_raw")
  /// Free-text role from the roster, e.g. "BARTENDER", "CHEF".
  category       String?
  source         String?
  /// BUG-002 fix: idempotency key for re-running the real-data importer.
  externalRef    String?   @map("external_ref")
  /// IBG/BCII bartender certification expiry. Nullable because the real
  /// staffing roster records none — and a fabricated expiry date would drive
  /// real compliance decisions on event day. Unknown must stay unknown.
  certExpiresAt  DateTime? @map("cert_expires_at")
  /// Nullable: real day rates are negotiated per event, not in the roster.
  dayRate        Decimal?  @map("day_rate") @db.Decimal(10, 2)
  /// The same crew costs more away from home — AMM’s roster quotes two
  /// figures, a local rate and an outstation one. dayRate above is the local
  /// (in-city) rate; this is what they are paid for an event outside it.
  dayRateOutstation Decimal? @map("day_rate_outstation") @db.Decimal(10, 2)
  /// Whether the freelancer agreement has been signed. A boolean, not a date:
  /// the roster records only that it happened, and inventing a date would put
  /// a fabricated figure on a contract record.
  agreementSigned Boolean  @default(false) @map("agreement_signed")
  eventsCount    Int       @default(0) @map("events_count")
  rating         Decimal?  @db.Decimal(2, 1)
  isAvailable    Boolean   @default(true) @map("is_available")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  city      City?     @relation(fields: [cityId], references: [id])
  crewRequests CrewRequest[]

  @@unique([workspaceId, phone])
  @@unique([workspaceId, externalRef])
  @@map("freelancers")
}

// =========================================================================
// KNOWLEDGE / SOPS
// =========================================================================

/// One 'are you free for this event?' asked of one bartender.
///
/// Freelancer.isAvailable is a single global flag — useful for 'who is
/// around at all', useless for staffing a date, because a bartender free on
/// the 12th is not free on the 14th. This table is the per-event answer, and
/// it is also the audit trail: who was asked, when, what they said, and
/// through which channel.
model CrewRequest {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  freelancerId String    @map("freelancer_id") @db.Uuid
  status       CrewRequestStatus @default(SENT)
  /// How it was asked — 'whatsapp', or 'manual' when somebody phoned them.
  channel      String    @default("whatsapp")
  /// The provider's own message id, so a delivery webhook can find this row.
  providerRef  String?   @map("provider_ref")
  /// What they actually replied, kept verbatim. A tapped button is tidy; a
  /// typed 'yes but only till 11' is the answer that matters and must not be
  /// flattened into a boolean.
  replyText    String?   @map("reply_text")
  sentAt       DateTime  @default(now()) @map("sent_at")
  respondedAt  DateTime? @map("responded_at")
  createdById  String?   @map("created_by") @db.Uuid

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  project    Project    @relation(fields: [projectId], references: [id])
  freelancer Freelancer @relation(fields: [freelancerId], references: [id])

  /// One live ask per person per event: asking twice is how somebody gets two
  /// messages and the second answer silently overwrites the first.
  @@unique([projectId, freelancerId])
  @@index([workspaceId, status])
  @@map("crew_requests")
}

enum CrewRequestStatus {
  SENT
  AVAILABLE
  UNAVAILABLE
  /// Sending failed, or the number is not on WhatsApp.
  FAILED
}

model Sop {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  department  String
  ownerId     String?   @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  versions  SopVersion[]

  @@map("sops")
}

model SopVersion {
  id          String   @id @default(uuid()) @db.Uuid
  sopId       String   @map("sop_id") @db.Uuid
  versionNo   Int      @map("version_no")
  body        String
  stepsCount  Int      @default(0) @map("steps_count")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  sop Sop @relation(fields: [sopId], references: [id])

  @@unique([sopId, versionNo])
  @@map("sop_versions")
}

// =========================================================================
// AUTOMATION ENGINE (blueprint §12)
// =========================================================================

model AutomationRule {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  triggerType    String   @map("trigger_type") // event | schedule | threshold | time_relative
  triggerConfig  Json     @map("trigger_config")
  actions        Json // [{type, config}, ...]
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  runs      AutomationRun[]

  @@map("automation_rules")
}

model AutomationRun {
  id            String              @id @default(uuid()) @db.Uuid
  ruleId        String              @map("rule_id") @db.Uuid
  triggeredBy   String              @map("triggered_by") // entity id or "schedule"
  triggerHash   String              @map("trigger_hash") // (ruleId, entityId, triggerHash) idempotency
  status        AutomationRunStatus @default(PENDING)
  attempt       Int                 @default(1)
  error         String?
  startedAt     DateTime            @default(now()) @map("started_at")
  finishedAt    DateTime?           @map("finished_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, triggeredBy, triggerHash])
  @@map("automation_runs")
}

// =========================================================================
// NOTIFICATIONS / AUDIT
// =========================================================================

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  icon       String?
  text       String
  readAt     DateTime? @map("read_at")
  sourceType String?   @map("source_type")
  sourceId   String?   @map("source_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

/// Universal, append-only audit trail. Never updated, never deleted — written
/// exclusively by the shared audit interceptor (blueprint §7/§30), not by
/// individual endpoint handlers.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "invoice.issue", "flow_step.complete"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId, at])
  @@map("audit_logs")
}

/// Backs idempotency-key support on financial/inventory mutation endpoints
/// (blueprint §7/§32). Short-lived; a cleanup job may prune rows older than
/// its retention window once introduced.
model IdempotencyKey {
  key         String   @id
  endpoint    String
  requestHash String   @map("request_hash")
  responseBody Json?   @map("response_body")
  statusCode  Int?     @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

/// A P&L statement someone builds by hand (Reports → P&L → Add P&L): for a
/// period, optionally one city or one project, with its own revenue, cost,
/// expense, other-income and tax lines. Separate from the computed actuals on
/// the P&L page — nothing here is added into those figures.
model PnlStatement {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  cityId      String?   @map("city_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  periodFrom  DateTime? @map("period_from") @db.Date
  periodTo    DateTime? @map("period_to") @db.Date
  notes       String?
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  lines PnlLine[]

  @@index([workspaceId, deletedAt])
  @@map("pnl_statements")
}

/// One line of a P&L statement. `section` is REVENUE, DIRECT_COST, OPEX,
/// OTHER_INCOME or TAX; amounts are positive and the section decides the sign.
model PnlLine {
  id          String  @id @default(uuid()) @db.Uuid
  statementId String  @map("statement_id") @db.Uuid
  section     String
  label       String
  amount      Decimal @db.Decimal(14, 2)
  position    Int     @default(0)

  statement PnlStatement @relation(fields: [statementId], references: [id])

  @@index([statementId])
  @@map("pnl_lines")
}
