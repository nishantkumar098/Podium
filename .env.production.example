# Podium — production settings. On the server:
#   cp .env.production.example .env.production   then fill in every <...>
# Never commit .env.production (it is git-ignored) and never paste its
# values into chat or email.

# ===== Your address =====
# The domain Podium is served at (no https://). Its DNS "A" record must point
# at this server's IP before starting, or HTTPS can't be issued.
DOMAIN=<podium.yourdomain.com>
WEB_BASE_URL=https://<podium.yourdomain.com>

# ===== Database (Supabase) =====
# Copy both from the .env on your own computer. Everyone signs in to the
# same data.
#   DATABASE_URL — what the app uses (keep its ?connection_limit=5)
#   DIRECT_URL   — what database migrations use
DATABASE_URL=<postgresql://...pooler.supabase.com:5432/postgres?connection_limit=5>
DIRECT_URL=<postgresql://...pooler.supabase.com:5432/postgres>
# Only used by `prisma migrate dev` on a developer machine — never on the
# server. Leave this placeholder. NEVER point it at the real database: Prisma
# wipes whatever database this names.
SHADOW_DATABASE_URL=postgresql://unused:unused@localhost:5432/unused

# ===== Sign-in =====
# A NEW long random secret for production. Generate it on the server:
#   openssl rand -hex 48
# Changing it signs everyone out once, which is expected on first launch.
JWT_ACCESS_SECRET=<random>
# Optional — refresh tokens are random values stored in the database, not
# signed with this. Set any random value.
JWT_REFRESH_SECRET=<random>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Google (Mail / Calendar / Meet) =====
# Leave "disabled" to launch without Google, or set up per
# docs/integration-setup.md. In Google Cloud Console add the redirect URI
# https://<your domain>/mail/connect to the OAuth client.
GOOGLE_INTEGRATION_MODE=disabled
GOOGLE_TOKEN_KEY=<openssl rand -hex 32>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<podium.yourdomain.com>/mail/connect
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events"

# ===== E-mail (invoice delivery, password-invite links) =====
# "disabled" until you have SMTP details (e.g. Hostinger email or Gmail SMTP).
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@ammbrands.com
MAIL_FROM_NAME=AMM Brands LLP

# ===== Workspace =====
SEED_WORKSPACE_NAME=AMM Brands LLP

# ===== Set automatically — do not add =====
# docker-compose.prod.yml sets these for each service:
#   NODE_ENV=production, API_PORT=3001, REDIS_URL=redis://redis:6379,
#   STORAGE_DRIVER=local, STORAGE_LOCAL_PATH=/data/storage, TRUST_PROXY=1,
#   API_BASE_URL=http://api:3001 (baked into the web build)
