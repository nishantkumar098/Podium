# ===== Database =====
DATABASE_URL="postgresql://podium:podium_dev_password@localhost:5432/podium_test?schema=public"

# Prisma needs a SEPARATE, DISPOSABLE database to diff migrations against: it
# DROPS AND RECREATES whatever database it is handed here. Never point this at
# DATABASE_URL. (Doing exactly that on 2026-09-11 wiped the dev database; it
# was recoverable only because the data was still seed-generated. It no longer
# is -- this database now holds 65,000+ real, irreplaceable AMM records.)
# Create it once with:  createdb -h localhost -U podium podium_shadow
SHADOW_DATABASE_URL="postgresql://podium:podium_dev_password@localhost:5432/podium_test_shadow?schema=public"

# ===== Redis / Queue =====
REDIS_URL="redis://localhost:6379"

# ===== Auth =====
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Google OAuth (SSO + Gmail/Calendar/Meet integration reuse — see docs/integration-setup.md)
# disabled (default) = every Google endpoint returns 503 with setup instructions.
# sandbox            = clearly-labelled fixture data, no network call, nothing sent.
# live               = requires all three credentials below; refuses to activate without them.
GOOGLE_INTEGRATION_MODE="disabled"
# Optional 32-byte secret for encrypting stored OAuth tokens at rest.
# Falls back to JWT_ACCESS_SECRET in development; set this in production.
GOOGLE_TOKEN_KEY=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/auth/google/callback"
# Scopes must stay exactly this minimal set — see blueprint §16 / docs/integration-setup.md
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events"

# ===== File storage =====
# "local" uses disk storage behind the same interface as S3 for local dev.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.local-storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ===== App =====
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"

# ===== Workspace seed =====
SEED_WORKSPACE_NAME="AMM Brands LLP"
SEED_WORKSPACE_GSTIN="08AACFA1234A1Z5"
