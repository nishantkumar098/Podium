{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "target": "ES2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
